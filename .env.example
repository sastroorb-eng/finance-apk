# Copy to .env and fill in from Supabase Dashboard -> Project Settings -> API.
# Leave empty to run in Demo Mode with sample data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# NOTE: Never put OpenAI/Gemini keys here. EXPO_PUBLIC_* values are bundled into the app.
# AI keys live only in Supabase secrets (see README).
